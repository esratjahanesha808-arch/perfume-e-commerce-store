# Paste these into Vercel → Project → Settings → Environment Variables → Production
# Replace placeholders. Only DATABASE_URL + AUTH_SECRET are required for portfolio.

# ── REQUIRED ──
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
AUTH_SECRET=paste-output-from-npm-run-deploy-check
AUTH_TRUST_HOST=true

# Set after first deploy (use your real .vercel.app URL):
NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
AUTH_URL=https://your-project.vercel.app

# ── OPTIONAL (checkout demo — copy from your .env.local if you have Stripe test keys) ──
# STRIPE_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── NOT NEEDED FOR PORTFOLIO — leave unset ──
# CLOUDINARY_*
# UPSTASH_*
# MEILISEARCH_*
# RESEND_*
# SENTRY_*
